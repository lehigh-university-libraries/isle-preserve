From 673b78254e7f53852794824aa3c0d75b2a685b49 Mon Sep 17 00:00:00 2001
From: Joe Corall <jjc223@lehigh.edu>
Date: Thu, 20 Aug 2026 14:29:05 -0400
Subject: [PATCH 1/2] Fix microservice rewrite for canonical event URLs

---
 .../MicroserviceRewriteSubscriber.php         | 49 ++++++++++++++-----
 .../MicroserviceRewriteSubscriberTest.php     | 16 ++++++
 2 files changed, 53 insertions(+), 12 deletions(-)

diff --git a/modules/islandora_microservice_rewrite/src/EventSubscriber/MicroserviceRewriteSubscriber.php b/modules/islandora_microservice_rewrite/src/EventSubscriber/MicroserviceRewriteSubscriber.php
index 332c76b42..7bd5d722f 100644
--- a/modules/islandora_microservice_rewrite/src/EventSubscriber/MicroserviceRewriteSubscriber.php
+++ b/modules/islandora_microservice_rewrite/src/EventSubscriber/MicroserviceRewriteSubscriber.php
@@ -51,26 +51,26 @@ public function rewriteMessageUris(GeneratedEventMessageEventInterface $event) {
       return;
     }
 
-    $message = $event->getMessage();
-    if (empty($message['attachment']['content']) || !is_array($message['attachment']['content'])) {
-      return;
-    }
-
     [$find, $replace] = $this->parseRewriteRules($rules);
     if (empty($find)) {
       return;
     }
 
-    foreach (['file_upload_uri', 'source_uri', 'destination_uri'] as $field) {
-      if (isset($message['attachment']['content'][$field])) {
-        $message['attachment']['content'][$field] = str_replace(
-          $find,
-          $replace,
-          $message['attachment']['content'][$field]
-        );
+    $message = $event->getMessage();
+    if (!empty($message['attachment']['content']) && is_array($message['attachment']['content'])) {
+      foreach (['file_upload_uri', 'source_uri', 'destination_uri'] as $field) {
+        if (isset($message['attachment']['content'][$field])) {
+          $message['attachment']['content'][$field] = str_replace(
+            $find,
+            $replace,
+            $message['attachment']['content'][$field]
+          );
+        }
       }
     }
 
+    $this->rewriteLinkUrls($message, $find, $replace);
+
     $event->setMessage($message);
   }
 
@@ -105,4 +105,29 @@ protected function parseRewriteRules($rules) {
     return [$find, $replace];
   }
 
+  /**
+   * Rewrites ActivityStreams link URLs in a generated event message.
+   *
+   * @param array $message
+   *   The generated event message.
+   * @param array $find
+   *   The configured URL fragments to replace.
+   * @param array $replace
+   *   The replacement URL fragments.
+   */
+  protected function rewriteLinkUrls(array &$message, array $find, array $replace) {
+    foreach (['actor', 'object'] as $section) {
+      if (empty($message[$section]['url']) || !is_array($message[$section]['url'])) {
+        continue;
+      }
+
+      foreach ($message[$section]['url'] as &$link) {
+        if (is_array($link) && isset($link['href'])) {
+          $link['href'] = str_replace($find, $replace, $link['href']);
+        }
+      }
+      unset($link);
+    }
+  }
+
 }
diff --git a/modules/islandora_microservice_rewrite/tests/src/Kernel/MicroserviceRewriteSubscriberTest.php b/modules/islandora_microservice_rewrite/tests/src/Kernel/MicroserviceRewriteSubscriberTest.php
index ba9abf662..6a3b94edd 100644
--- a/modules/islandora_microservice_rewrite/tests/src/Kernel/MicroserviceRewriteSubscriberTest.php
+++ b/modules/islandora_microservice_rewrite/tests/src/Kernel/MicroserviceRewriteSubscriberTest.php
@@ -109,6 +109,22 @@ public function testMultipleRulesAreApplied() {
     );
   }
 
+  /**
+   * Tests that generated event canonical URLs are rewritten.
+   */
+  public function testCanonicalUrlIsRewritten() {
+    $this->setRewriteRules('http://localhost|https://preserve.lehigh.edu');
+
+    $message = $this->generateDerivativeMessage([
+      'source_uri' => 'http://localhost/file.pdf',
+    ]);
+
+    $this->assertEquals(
+      'https://preserve.lehigh.edu/node/' . $this->entity->id(),
+      $message['object']['url'][0]['href']
+    );
+  }
+
   /**
    * Tests that URI values stay untouched when no rules are configured.
    */

