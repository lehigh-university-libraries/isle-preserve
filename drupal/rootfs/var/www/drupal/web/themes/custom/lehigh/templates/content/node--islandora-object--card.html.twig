{# Keep descriptive links outside the card's title and thumbnail links. #}
{% set classes = [
  'node', 'node--type-islandora-object', 'node--view-mode-' ~ view_mode|clean_class,
  'agileCard', 'repository-card', is_collection ? 'collection',
  not node.isPublished() ? 'node--unpublished',
] %}
{% set link = node.field_link.uri ?: url %}
{% set thumbnail = content.field_thumbnail|render %}
{% if not thumbnail|trim %}
  {% set thumbnail = content.field_representative_media|render %}
{% endif %}
{% if not thumbnail|trim %}
  {% set thumbnail = content.media_evas_thumbnail|render %}
{% endif %}
<article{{ attributes.addClass(classes) }}>
  {{ title_prefix }}
  <div class="repository-card__media">
    {% if thumbnail|striptags('<img>')|trim %}
      {{ thumbnail }}
    {% else %}
      <span class="material-symbols-outlined repository-card__placeholder" aria-hidden="true">description</span>
    {% endif %}
  </div>
  <div{{ content_attributes.addClass('node--content', 'repository-card__body') }}>
    <div class="content-label-compact">{{ is_collection ? node.field_model.entity.label : node.field_member_of.entity.label }}</div>
    <h3{{ title_attributes }}><a href="{{ link }}">{{ label }}</a></h3>
    {{ title_suffix }}
    {{ content|without('field_thumbnail', 'media_evas_thumbnail', 'field_representative_media', 'field_type', 'field_resource_type', 'field_resource_label', 'field_link', 'group_footer') }}
    <a class="more" href="{{ link }}">{{ is_collection ? 'View collection'|t : 'View item'|t }}<span class="visually-hidden">: {{ label }}</span></a>
  </div>
  {% if content.group_footer or reference_count > 0 %}
    <footer class="repository-card__footer">
      {% if reference_count > 0 %}
        <div class="item-label reference-count">{% if is_collection and not is_sub_collection %}{% trans %}1 sub-collection{% plural reference_count %}{{ count }} sub-collections{% endtrans %}{% else %}{% trans %}1 item{% plural reference_count %}{{ count }} items{% endtrans %}{% endif %}</div>
      {% endif %}
      {{ content.group_footer }}
    </footer>
  {% endif %}
</article>
