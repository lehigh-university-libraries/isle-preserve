{% set classes = [
  'node', 'node--type-islandora-object', 'node--view-mode-' ~ view_mode|clean_class,
  'repository-object', is_collection ? 'collection',
  not node.isPublished() ? 'node--unpublished',
] %}
<article{{ attributes.addClass(classes) }}>
  {{ title_prefix }}
  {% if not page %}<h2{{ title_attributes }}>{{ label }}</h2>{% endif %}
  {{ title_suffix }}
  {% if not is_collection %}
    {% if node.field_model.entity.label != 'Compound Object' %}
      <h2>{{ 'About this item'|t }}</h2>
    {% endif %}
    {{ content }}
  {% endif %}
</article>
